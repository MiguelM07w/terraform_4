root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 requiere BOM para interpretar UTF-8 correctamente
[*.ps1]
charset = utf-8-bom
indent_size = 4
